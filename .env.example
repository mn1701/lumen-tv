# Export these variables in the shell running the companion.
LUMEN_ADDR=127.0.0.1:8090
LUMEN_ORIGINS=http://127.0.0.1:5173
LUMEN_CATALOG=../config/catalog.json
LUMEN_MEDIA=../media
LUMEN_DATA=./data
# Optional AES-256-GCM state encryption: 64 hexadecimal characters.
# LUMEN_STATE_KEY=
# Optional administration credential: at least 32 random characters.
# LUMEN_ADMIN_TOKEN=
