{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Lumen catalog",
  "type":"object",
  "additionalProperties":false,
  "required":["version","entries"],
  "properties":{
    "version":{"const":1},
    "entries":{"type":"array","maxItems":1000,"items":{"type":"object","additionalProperties":false,"required":["id","title","kind"],"properties":{
      "id":{"type":"string","pattern":"^[a-z0-9][a-z0-9_-]{0,63}$"},
      "title":{"type":"string","minLength":1,"maxLength":160},
      "kind":{"enum":["video","audio","image","native"]},
      "collection":{"type":"string"},"description":{"type":"string","maxLength":2000},
      "file":{"type":"string","minLength":1},"appId":{"type":"string","pattern":"^[a-z0-9][a-z0-9.-]{1,127}$"},"mime":{"type":"string"},"duration":{"type":"number","minimum":0}
    },"allOf":[{"if":{"properties":{"kind":{"const":"native"}}},"then":{"required":["appId"],"not":{"required":["file"]}},"else":{"required":["file"],"not":{"required":["appId"]}}}]}}
  }
}
